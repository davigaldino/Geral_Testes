# Autenticacao: "client_credentials" ou "username_password"
AUTH_METHOD=username_password

# SharePoint
SHAREPOINT_SITE_URL=https://escolatrabalhador4.sharepoint.com/sites/portalservicos
SHAREPOINT_LIST_TITLE=reposta_curadoria

# Credenciais (usar conforme AUTH_METHOD)
# Para username_password
SHAREPOINT_USERNAME=usuario@seu-dominio.onmicrosoft.com
SHAREPOINT_PASSWORD=sua_senha_forte

# App Registration (Entra ID) - CLIENT_ID obrigatrio em ambos os m9todos
CLIENT_ID=
# Para client_credentials (App Registration no Entra ID)
CLIENT_SECRET=

# Saida
# Opcional: caminho do CSV. Suporta placeholder {date} no formato YYYYMMDD
OUTPUT_PATH=output/sharepoint_lista_{date}.csv

# Campos opcionais (nomes internos), separados por virgula. Se vazio, exporta todos.
FIELDS=
